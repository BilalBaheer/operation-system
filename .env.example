# Copy to .env for local Docker Compose runs. NEVER commit the real .env file.
# In Azure these values come from Key Vault, not from a file.

# --- shared ---
JWT_SECRET=change-me-to-a-long-random-string

# --- PostgreSQL (local container) ---
POSTGRES_USER=oms_dev
POSTGRES_PASSWORD=localdevpassword

# --- seed data (local only) ---
SEED_PASSWORD=LocalDemo!2026

# --- inspection-service ---
REPO_DRIVER=postgres
DB_SSL=false
