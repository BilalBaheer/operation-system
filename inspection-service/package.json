{
  "name": "oms-inspection-service",
  "version": "1.1.0",
  "description": "OMS inspection record management microservice",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js",
    "demo": "node demo/run-demo.js",
    "test": "jest tests --testPathIgnorePatterns=integration",
    "test:coverage": "jest tests --coverage --testPathIgnorePatterns=integration",
    "test:integration": "jest tests/integration --runInBand"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "src/server.js",
      "src/config.js",
      "src/db.js"
    ]
  }
}
